# ==============================================================================
# Modern Shop - Enterprise Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Django Application
# ------------------------------------------------------------------------------
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-replace-with-a-cryptographically-strong-secret-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,web

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL in Production, SQLite fallback locally)
# ------------------------------------------------------------------------------
DB_ENGINE=sqlite
POSTGRES_DB=marketplace_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# Celery Asynchronous Task Queue & Message Broker
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# When CELERY_TASK_ALWAYS_EAGER is True, tasks run inline without needing Redis
CELERY_TASK_ALWAYS_EAGER=True

# ------------------------------------------------------------------------------
# High-Volume Caching Layer (Redis with fallback to LocMemCache)
# ------------------------------------------------------------------------------
USE_REDIS_CACHE=False
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# ------------------------------------------------------------------------------
# Cloud Object Storage (AWS S3 or Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# ------------------------------------------------------------------------------
# Payment Gateways (Production & Sandbox Keys)
# ------------------------------------------------------------------------------
# Razorpay (Cards, UPI, Netbanking, Wallets)
RAZORPAY_KEY_ID=rzp_test_ModernShop2026
RAZORPAY_KEY_SECRET=secret_test_ModernShop2026
RAZORPAY_WEBHOOK_SECRET=webhook_secret_ModernShop2026
RAZORPAY_CURRENCY=INR

# Stripe (Global Cards, Apple Pay, Google Pay)
STRIPE_PUBLIC_KEY=pk_test_NexaMarket2026
STRIPE_SECRET_KEY=sk_test_NexaMarket2026
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# ------------------------------------------------------------------------------
# Outbound Email Notifications (SMTP with console fallback)
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
ADMIN_EMAIL=sanjaisam63@gmail.com
DEFAULT_FROM_EMAIL=Modern Shop <sanjaisam63@gmail.com>
