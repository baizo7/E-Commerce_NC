# NexaMarket Multi-Vendor Marketplace - Environment Configuration Template
# Copy this file to .env and configure with your local or production credentials.

DJANGO_SECRET_KEY=replace-with-a-secure-random-key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com

DB_ENGINE=django.db.backends.postgresql
DB_NAME=nexamarket_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Razorpay Production / Test Credentials
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_your_key_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_CURRENCY=INR

# Stripe (Optional)
STRIPE_PUBLIC_KEY=pk_live_your_key_here
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_CURRENCY=usd

# Production SMTP (e.g. Gmail App Password or SendGrid)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sanjaisam63@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
ADMIN_EMAIL=sanjaisam63@gmail.com
DEFAULT_FROM_EMAIL=NexaMarket <sanjaisam63@gmail.com>
